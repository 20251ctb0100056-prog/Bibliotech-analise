        <mxCell id="ynxGYiXlT00DdVrhLZrB-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p&gt;SPT (Sistema de Processamento de Transações)&lt;/p&gt;&lt;p&gt;&lt;b&gt;Justificativa:&lt;/b&gt; O BiblioTech é um SPT porque automatiza, registra e processa as operações diárias e rotineiras da biblioteca (como empréstimos, devoluções, cadastros e reservas), mantendo o controle operacional do acervo atualizado em tempo real.&lt;/p&gt;" vertex="1">
          <mxGeometry height="30" width="470" x="-460" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="ynxGYiXlT00DdVrhLZrB-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;blockquote&gt;&lt;p&gt;&lt;b&gt;Decisão de Modelagem:&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Separou-se &lt;code&gt;Devolver livro&lt;/code&gt; (ação de solicitação do Leitor) de &lt;code&gt;Registrar devolução&lt;/code&gt; (baixa física realizada pelo Bibliotecário) para delimitar as responsabilidades de cada perfil no processo. Além disso, incluiu-se &lt;code&gt;Autenticar usuário&lt;/code&gt; como pré-requisito implícito de acesso e adicionou-se o ator &lt;code&gt;Serviço de E-mail&lt;/code&gt; para automatizar as notificações.&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="351" width="540" x="620" y="800" as="geometry" />
        </mxCell>
